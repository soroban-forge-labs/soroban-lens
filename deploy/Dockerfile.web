# Web UI — build with Node, serve as static files.
#
# Vite inlines VITE_* variables at BUILD time, so the API URL must be known when
# the bundle is produced, not when the container starts. Compose passes it as a
# build arg; changing it means rebuilding this image, not restarting it.
#
# The one exception is the network list: LENS_WEB_NETWORKS and
# LENS_WEB_OPTIONAL_NETWORKS are read at container start by web-networks.sh,
# and override the baked-in VITE_LENS_NETWORKS when set.

FROM node:26-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @soroban-lens/web --include-workspace-root

COPY apps/web/ apps/web/

ARG VITE_LENS_NETWORKS='{"testnet":"http://localhost:8080"}'
ENV VITE_LENS_NETWORKS=$VITE_LENS_NETWORKS
# Optional block-explorer map; empty means "use the built-in Stellar Expert
# defaults", which is what a plain compose build gets.
ARG VITE_LENS_EXPLORERS=''
ENV VITE_LENS_EXPLORERS=$VITE_LENS_EXPLORERS
RUN npm run build --workspace @soroban-lens/web


# The output is plain static files, so the runtime image needs a web server and
# nothing else — no Node, no node_modules, no source. `vite preview` is a
# development server and is deliberately not used here.
#
# nginx-unprivileged runs as a non-root user and listens on 8080, so nothing in
# the stack needs root.
FROM nginxinc/nginx-unprivileged:1.29-alpine

COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY deploy/web-nginx.conf /etc/nginx/conf.d/default.conf
# Writes /networks.json at start, so a compose profile can add a network to the
# switcher without a rebuild (#82). The image's entrypoint runs this directory.
COPY --chmod=0755 deploy/web-networks.sh /docker-entrypoint.d/40-lens-networks.sh

EXPOSE 8080
