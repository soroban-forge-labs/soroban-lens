# Shared image for the indexer and the API.
#
# Node 26 rather than 22: `node:sqlite` is built in, so there is no native
# compilation step and no build toolchain in the final image.
#
# Two stages: the builder compiles TypeScript with dev dependencies; the runtime
# stage keeps only built output, production dependencies and the fixtures the
# seed command reads.

FROM node:26-alpine AS build

WORKDIR /app

# Copy manifests first so `npm ci` is cached until a dependency actually changes.
COPY package.json package-lock.json ./
COPY packages/ingest/package.json  packages/ingest/
COPY packages/store/package.json   packages/store/
COPY packages/api/package.json     packages/api/
COPY packages/cli/package.json     packages/cli/
COPY apps/web/package.json         apps/web/

# The web app is a separate image; skip its (large) dev dependencies here.
RUN npm ci --workspace @soroban-lens/ingest \
           --workspace @soroban-lens/store \
           --workspace @soroban-lens/api \
           --workspace @soroban-lens/cli \
           --include-workspace-root

COPY tsconfig.base.json ./
COPY packages/ packages/
COPY fixtures/ fixtures/

RUN npm run build --workspace @soroban-lens/store \
                  --workspace @soroban-lens/ingest \
                  --workspace @soroban-lens/api \
                  --workspace @soroban-lens/cli


FROM node:26-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

# Install production dependencies only. The manifests are needed here because
# npm links the local workspaces and resolves the lockfile at install time.
COPY package.json package-lock.json ./
COPY packages/ingest/package.json  packages/ingest/
COPY packages/store/package.json   packages/store/
COPY packages/api/package.json     packages/api/
COPY packages/cli/package.json     packages/cli/
COPY apps/web/package.json         apps/web/

RUN npm ci --omit=dev \
           --workspace @soroban-lens/ingest \
           --workspace @soroban-lens/store \
           --workspace @soroban-lens/api \
           --workspace @soroban-lens/cli \
           --include-workspace-root \
    && npm cache clean --force

# Copy only emitted JavaScript, the committed OpenAPI spec, and fixtures used
# by `lens seed`. Source, tests, tsconfig files and TypeScript stay in the
# builder.
COPY --from=build /app/packages/ingest/dist packages/ingest/dist
COPY --from=build /app/packages/store/dist  packages/store/dist
COPY --from=build /app/packages/api/dist    packages/api/dist
COPY --from=build /app/packages/api/openapi.json packages/api/openapi.json
COPY --from=build /app/packages/cli/dist    packages/cli/dist
COPY --from=build /app/fixtures             fixtures

# The data volume is owned by the unprivileged `node` user that ships with the
# image; running as root here would leave root-owned files on a bind mount.
RUN mkdir -p /app/data && chown -R node:node /app/data
USER node

ENV LENS_DB_PATH=/app/data/lens.db \
    LENS_DATA_DIR=/app/data

CMD ["node", "packages/cli/dist/bin.js", "doctor"]
