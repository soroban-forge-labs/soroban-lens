{
  "name": "@soroban-lens/ingest",
  "version": "0.1.0",
  "description": "Module 1 — Soroban RPC client, event polling, cursor tracking.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": "./dist/index.js" },
  "bin": { "soroban-lens-ingest": "./dist/bin.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:coverage": "npm run build && node --test --experimental-test-coverage test/*.test.js",
    "record-fixture": "npm run build && node dist/scripts/record-fixture.js"
  },
  "dependencies": { "@stellar/stellar-sdk": "^17.4.0" },
  "devDependencies": { "typescript": "^7.0.2", "@types/node": "^26.6.6" }
}