node_modules/
dist/
*.tsbuildinfo

# tsc emits next to the source when it is invoked with --noEmit false. Nothing
# in apps/web is authored as .js — Vite compiles the .tsx/.ts directly — so any
# .js here is stale build output that shadows nothing and confuses greps.
apps/web/src/**/*.js
apps/web/vite.config.js

.env
.env.local
data/
*.db
*.db-wal
*.db-shm
.DS_Store
temp_auto_push.bat

# Emitted by tsconfig.test.json so node --test has real .js to import.
apps/web/.test-build/
# Local data directory
data/
# Generated from packages/api/openapi.json by `npm run generate` in packages/client.
packages/client/src/schema.d.ts

bench/results/

# Terraform: state contains the RPC URL and API keys, tfvars hold them too.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.tfvars
*.tfvars.json
.gitignore
branch_structure.json
