{
  "name": "@soroban-lens/web",
  "version": "0.1.0",
  "description": "Module 4 — single-page Soroban event explorer.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --force",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/api.test.js test/format.test.js test/i18n.test.js test/route.test.js",
    "test:a11y": "node test/accessibility.test.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@axe-core/playwright": "^4.10.2",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.55.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
