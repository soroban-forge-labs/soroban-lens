# soroban-lens configuration. Copy to .env; every value here is the default.
#
#   cp .env.example .env && docker compose up

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# testnet | mainnet | futurenet
LENS_NETWORK=testnet

# Override the network's RPC endpoint. Leave empty to use the preset:
#   testnet    https://soroban-testnet.stellar.org
#   futurenet  https://rpc-futurenet.stellar.org
#
# REQUIRED for mainnet. There is no free public mainnet RPC with useful
# retention — point this at your own node or a commercial provider.
LENS_RPC_URL=

# ---------------------------------------------------------------------------
# RPC retries
# ---------------------------------------------------------------------------
#
# Full-jitter exponential backoff. Raise the attempts on a flaky provider;
# lower the delays if you would rather fail fast than wait.

# Total attempts including the first.
LENS_RETRY_ATTEMPTS=5

# Delay before the first retry, in milliseconds.
LENS_RETRY_BASE_DELAY_MS=250

# Ceiling on any single retry delay, in milliseconds.
LENS_RETRY_MAX_DELAY_MS=30000

# ---------------------------------------------------------------------------
# What to index
# ---------------------------------------------------------------------------

# Comma-separated contract ids. The default is the testnet Stellar Asset
# Contract for native XLM, which is always emitting events — good for a first
# run, and a sensible thing to replace with your own contract.
#
# Leaving this empty indexes EVERY contract on the network. That works, and it
# fills the database quickly.
LENS_CONTRACT_IDS=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# First ledger to read when there is no stored cursor. Empty means "as far back
# as the node still retains", roughly 7 days.
LENS_START_LEDGER=

# Events per RPC request, 1-10000.
LENS_PAGE_SIZE=200

# How long to wait after catching up to the network tip, in milliseconds.
LENS_POLL_INTERVAL_MS=2000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Inside the containers these live on the `lens-data` volume; the defaults below
# are what a local (non-Docker) run uses.
LENS_DB_PATH=./data/lens.db
LENS_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Services
# ---------------------------------------------------------------------------

LENS_API_PORT=8080
LENS_WEB_PORT=5173

# Access-Control-Allow-Origin for the API. Tighten this before exposing it.
LENS_CORS_ORIGIN=*

# Which API(s) the web UI talks to, as JSON: { label: apiBaseUrl }.
# These URLs are used by the browser, so they are host-visible URLs.
# Baked in at image BUILD time — change it and rebuild: docker compose build web
LENS_WEB_NETWORKS={"testnet":"http://localhost:8080"}
